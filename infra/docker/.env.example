# Copy to infra/docker/.env (git-ignored) and set real local values.
# Names only; never commit values. Production values come from the secret manager.

ZS_ENVIRONMENT=LOCAL

ZS_DB_NAME=zellastay
ZS_DB_USER=zellastay
ZS_DB_PASSWORD=
ZS_DB_HOST_PORT=5432
ZS_DB_URL=jdbc:postgresql://localhost:5432/zellastay

ZS_REDIS_HOST=localhost
ZS_REDIS_HOST_PORT=6379
ZS_REDIS_PORT=6379
ZS_REDIS_PASSWORD=

ZS_SERVER_PORT=8080
ZS_MANAGEMENT_PORT=8081

# Non-secret key label. The key and pepper are files created by infra/scripts/generate-local-secrets.sh
ZS_IDENTITY_TOKEN_SIGNING_KEY_ID=local-1
ZS_IDENTITY_MFA_ENCRYPTION_KEY_ID=local-mfa-1

# Optional: create the first Super Admin once (needs the two values below, then set back to false)
ZS_IDENTITY_BOOTSTRAP_ENABLED=false
ZS_IDENTITY_BOOTSTRAP_ADMIN_EMAIL=
